# Database
DATABASE_URL=postgresql+asyncpg://twitter_bookmarks:PASSWORD@localhost:5432/twitter_bookmarks

# X API
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_NUMERIC_ID=
X_USERNAME=
X_REDIRECT_URI=http://localhost:8765/callback
X_REFRESH_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Resend
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@yourdomain.com
DIGEST_TO_EMAIL=you@yourdomain.com

# Dashboard
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# App
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# Scheduler
BOOKMARK_PULL_INTERVAL=86400
DIGEST_DAY_OF_WEEK=mon
DIGEST_HOUR=8

# Classifier feedback
FEEDBACK_FEW_SHOT_COUNT=12
